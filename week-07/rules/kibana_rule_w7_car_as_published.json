{
  "rule_id": "w7-car-2014-04-003-powershell-as-published",
  "name": "W7 - CAR-2014-04-003 PowerShell Execution (as published)",
  "description": "MITRE CAR-2014-04-003 pseudocode taken literally: powershell.exe whose parent is not explorer.exe. Kept to show the false-positive volume before tuning.",
  "type": "esql",
  "language": "esql",
  "query": "FROM th-w7-sysmon METADATA _id, _index, _version\n| WHERE event_id == 1\n  AND ENDS_WITH(TO_LOWER(image), \"\\\\powershell.exe\")\n  AND NOT ENDS_WITH(TO_LOWER(parent_image), \"\\\\explorer.exe\")\n| KEEP _id, _index, _version, @timestamp, hostname, user, parent_image, command_line",
  "risk_score": 21,
  "severity": "low",
  "interval": "5m",
  "from": "now-30d",
  "max_signals": 300,
  "enabled": true,
  "tags": [
    "threat-hunting-project1",
    "week-07",
    "MITRE CAR",
    "CAR-2014-04-003",
    "phishing-kz"
  ],
  "references": [
    "https://car.mitre.org/analytics/CAR-2014-04-003/",
    "https://attack.mitre.org/techniques/T1059/001/"
  ],
  "false_positives": [
    "New IT automation that starts PowerShell from a service - add (parent + exact command line) to the allow-list after review",
    "Users who start PowerShell with -WindowStyle Hidden from a desktop shortcut"
  ],
  "author": [
    "Kazhymukan Boris (threat-hunting-project1 group)"
  ],
  "license": "MIT",
