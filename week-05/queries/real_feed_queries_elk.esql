// ============================================================================
// Week 05 - Part B (real phishing feed) for Elastic (Kibana -> Discover -> ES|QL)
// Data: data/real/feed_for_splunk.csv uploaded via Kibana "Upload a file"
//       into index  th-real   (no timestamp column - let Kibana skip time field)
// Note: ES|QL RLIKE must match the WHOLE value, hence the ".*" around patterns.
// Note: a literal hyphen in a char class is written [-.] (hyphen first); [.-] is
//       parsed by Lucene as the range '.'..']' and raises a regex error.
// Expected numbers: 2026-10-02 snapshot (392 164 domains)
// ============================================================================

// R0  sanity check                                    (expected: 392 164)
FROM th-real | STATS count = COUNT(*)

// R1  STEP 1a - KZ brands, NAIVE "contains" rule      (expected: 214)
FROM th-real
| WHERE domain RLIKE ".*(kaspi|kaspl|kasp1|egov|e-gov|1414|eg0v|halyk|homebank|kazpost|post\\.kz|kazpochta|cdek|sdek|olx|kolesa-kz|kolesakz|krisha|fortebank|forte-bank|jusan).*"
  AND NOT domain RLIKE "(.*\\.)?(kaspi\\.kz|kaspibank\\.kz|cdn-kaspi\\.kz|egov\\.kz|gov\\.kz|halykbank\\.kz|homebank\\.kz|post\\.kz|cdek\\.kz|cdek\\.ru|olx\\.kz|kolesa\\.kz|krisha\\.kz|forte\\.kz|fortebank\\.com|jusan\\.kz)"
| STATS hits = COUNT(*)

// R1b examples of noise from the naive rule
FROM th-real
| WHERE domain RLIKE ".*(egov|1414|olx).*" AND NOT domain RLIKE "(.*[-.])?(egov|olx).*"
| KEEP domain
| LIMIT 15

// R2  STEP 1b - KZ brands, REFINED rule (keyword starts a label)   (expected: 14)
FROM th-real
| WHERE domain RLIKE "(.*[-.])?(kaspi|kaspl|kasp1|egov|eg0v|kazpost|kazpochta|cdek|sdek|halyk|homebank|olxkz|olx-kz|kolesakz|krisha|fortebank|jusan).*"
  AND NOT domain RLIKE "(.*[-.])?homebanking.*"
| KEEP domain, tld
| SORT domain
// verdicts for these 14 rows: data/real/kz_hits.csv

// R3  STEP 2 - global analogs                         (expected: USPS 1313, PayPal 1078, DHL 404, OLX 55, Gosuslugi 16)
FROM th-real
| WHERE NOT domain RLIKE ".*olxkz.*"
  AND NOT domain RLIKE "(.*\\.)?(paypal\\.com|paypal\\.me|dhl\\.com|dhl\\.de|usps\\.com|gosuslugi\\.ru|olx\\.(kz|pl|ua|ro|bg|pt|com|ba|uz))"
| EVAL brand = CASE(
    domain RLIKE "(.*[-.])?paypal.*",    "PayPal (~Kaspi)",
    domain RLIKE "(.*[-.])?dhl.*",       "DHL (~Kazpost/CDEK)",
    domain RLIKE "(.*[-.])?usps.*",      "USPS (~Kazpost)",
    domain RLIKE "(.*[-.])?gosuslugi.*", "Gosuslugi (~eGov)",
    domain RLIKE "(.*[-.])?olx.*",       "OLX abroad (~OLX.kz)",
    null)
| WHERE brand IS NOT NULL
| STATS count = COUNT(*) BY brand
| SORT count DESC

// R4  triage signal - TLDs of brand phishing domains (expected: .top first)
FROM th-real
| WHERE domain RLIKE "(.*[-.])?(paypal|dhl|usps|gosuslugi|olx|kaspi|kaspl).*"
| STATS count = COUNT(*) BY tld
| SORT count DESC
| LIMIT 10
